{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListujTylkoMojPrefiks",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::zlecenia-daniel-uwb-2026",
      "Condition": { "StringLike": { "s3:prefix": ["student-daniel/*"] } }
    },
    {
      "Sid": "CzytajTylkoMojPrefiks",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::zlecenia-daniel-uwb-2026/student-daniel/*"
    }
  ]
}